<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>assignNewEvent</name>
        <label>assignNewEvent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>newResourceRecord.Ident__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Claimant__r.CRM_Person__r.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newResourceRecord.RegionNumber__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>regionNumberFromMunicipalityNumber</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newResourceRecord.BankAccountNumber__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Claimant__r.CRM_Person__r.INT_BankAccountNumber__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newResourceRecord.WorkplaceAddress__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Adresse</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newResourceRecord.EmailAddress__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Claimant__r.CRM_Person__r.INT_KrrEmail__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>createEvent</targetReference>
        </connector>
    </assignments>
    <description>Oppretter event i salesforce som senere blir omgjort til kafka og sendt til PLIS for opprettelse av ny ressurs</description>
    <environments>Default</environments>
    <formulas>
        <name>regionNumberFromMunicipalityNumber</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Claimant__r.CRM_Person__r.INT_MunicipalityNumber__c}, 2)</expression>
    </formulas>
    <interviewLabel>HOT LOS New Resource Kafka Event {!$Flow.CurrentDateTime}</interviewLabel>
    <label>HOT LOS New Resource Kafka Event</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>createEvent</name>
        <label>createEvent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>newResourceRecord</inputReference>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>assignNewEvent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsLos__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Resource_number__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>HOT_Claim__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>newResourceRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>HOT_LOS_NewResource__e</objectType>
    </variables>
